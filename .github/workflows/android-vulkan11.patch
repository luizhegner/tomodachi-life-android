diff --git a/runtime/vk11_pass.h b/runtime/vk11_pass.h
new file mode 100644
index 0000000..dd6b4f4
--- /dev/null
+++ b/runtime/vk11_pass.h
@@ -0,0 +1,100 @@
+/* The Android 1.1 renderer uses a single subpass. Pipeline compatibility
+ * depends on the attachment formats and sample count, not their layouts. */
+typedef struct {
+    VkFormat color[8], depth;
+    uint32_t colors;
+    VkSampleCountFlagBits samples;
+} PassFormats;
+
+static VkRenderPass legacy_pass(const PassFormats *f, const VkRenderingInfo *active) {
+    VkAttachmentDescription desc[9] = {0};
+    VkAttachmentReference color[8], depth = {VK_ATTACHMENT_UNUSED, VK_IMAGE_LAYOUT_UNDEFINED};
+    uint32_t count = 0;
+    for (uint32_t i = 0; i <= f->colors; i++) {
+        int ds = i == f->colors;
+        VkFormat format = ds ? f->depth : f->color[i];
+        VkAttachmentReference *ref = ds ? &depth : &color[i];
+        ref->attachment = VK_ATTACHMENT_UNUSED;
+        ref->layout = VK_IMAGE_LAYOUT_UNDEFINED;
+        if (!format) continue;
+        const VkRenderingAttachmentInfo *a = NULL;
+        if (active) a = ds ? (active->pDepthAttachment ? active->pDepthAttachment : active->pStencilAttachment)
+                           : &active->pColorAttachments[i];
+        ref->attachment = count;
+        ref->layout = a ? a->imageLayout : ds ? VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL : VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        VkAttachmentDescription *d = &desc[count++];
+        d->format = format;
+        d->samples = f->samples;
+        d->initialLayout = d->finalLayout = ref->layout;
+        d->loadOp = d->stencilLoadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        d->storeOp = d->stencilStoreOp = VK_ATTACHMENT_STORE_OP_STORE;
+    }
+    VkSubpassDescription sub = {0};
+    sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    sub.colorAttachmentCount = f->colors;
+    sub.pColorAttachments = color;
+    sub.pDepthStencilAttachment = &depth;
+    VkSubpassDependency deps[2] = {0};
+    for (unsigned i = 0; i < 2; i++) {
+        deps[i].srcSubpass = i ? 0 : VK_SUBPASS_EXTERNAL;
+        deps[i].dstSubpass = i ? VK_SUBPASS_EXTERNAL : 0;
+        deps[i].srcStageMask = i ? VK_PIPELINE_STAGE_ALL_GRAPHICS_BIT : VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+        deps[i].dstStageMask = i ? VK_PIPELINE_STAGE_ALL_COMMANDS_BIT : VK_PIPELINE_STAGE_ALL_GRAPHICS_BIT;
+        deps[i].srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        deps[i].dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    }
+    VkRenderPassCreateInfo info = {VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+    info.dependencyCount = 2;
+    info.pDependencies = deps;
+    info.attachmentCount = count;
+    info.pAttachments = desc;
+    info.subpassCount = 1;
+    info.pSubpasses = &sub;
+    VkRenderPass pass;
+    VKC(vkCreateRenderPass(V.device, &info, NULL, &pass));
+    return pass;
+}
+
+typedef struct LegacyFrame {
+    struct LegacyFrame *next;
+    VkRenderPass pass;
+    VkFramebuffer framebuffer;
+} LegacyFrame;
+static LegacyFrame *frames[NSLOT];
+
+static void release_frames(unsigned slot) {
+    while (frames[slot]) {
+        LegacyFrame *frame = frames[slot];
+        frames[slot] = frame->next;
+        vkDestroyFramebuffer(V.device, frame->framebuffer, NULL);
+        vkDestroyRenderPass(V.device, frame->pass, NULL);
+        free(frame);
+    }
+}
+
+static void legacy_begin(const VkRenderingInfo *info, const PassFormats *formats) {
+    VkImageView views[9];
+    uint32_t count = 0;
+    for (uint32_t i = 0; i < formats->colors; i++)
+        if (formats->color[i]) views[count++] = info->pColorAttachments[i].imageView;
+    if (formats->depth) views[count++] = (info->pDepthAttachment ? info->pDepthAttachment : info->pStencilAttachment)->imageView;
+    LegacyFrame *frame = calloc(1, sizeof *frame);
+    if (!frame) vkd_fail("out of memory creating Vulkan 1.1 framebuffer");
+    frame->pass = legacy_pass(formats, info);
+    VkFramebufferCreateInfo fb = {VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+    fb.renderPass = frame->pass;
+    fb.width = info->renderArea.extent.width;
+    fb.height = info->renderArea.extent.height;
+    fb.layers = info->layerCount;
+    fb.attachmentCount = count;
+    fb.pAttachments = views;
+    VKC(vkCreateFramebuffer(V.device, &fb, NULL, &frame->framebuffer));
+    frame->next = frames[R.cur];
+    frames[R.cur] = frame;
+    VkRenderPassBeginInfo begin = {VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    begin.framebuffer = frame->framebuffer;
+    begin.renderPass = frame->pass;
+    begin.renderArea = info->renderArea;
+    vkCmdBeginRenderPass(R.cmd, &begin, VK_SUBPASS_CONTENTS_INLINE);
+}
+static PassFormats current_formats;
